# Copy this file to .env and fill in the values. Do not commit .env.
# When deployed on Streamlit Community Cloud, enter the same values under App settings -> Secrets.

# ---- Answer source ----
# stub   placeholder answers (no network access required; used for development and tests)
# b_api  model service reached through its public ngrok address (POST /answer)
BACKEND=stub

# ---- Model service (used when BACKEND=b_api) ----
B_API_URL=https://<service-name>.ngrok-free.dev
B_API_KEY=
B_TIMEOUT=120
# JSON value sent as "state" with the first message of a conversation
B_INITIAL_STATE=null

# ---- Local directories (the defaults are sufficient) ----
CACHE_DIR=./app_cache
LOG_DIR=./logs
